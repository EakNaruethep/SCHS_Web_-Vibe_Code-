---
// Blog list (Makewebeasy "all blog" component), 20 per page with the shared pager script.
import { blogCard } from '../lib/cards.js';
import styles from '../data/site/styles.json';
const { items, id = 'SECTION_PAGE' } = Astro.props;
const cells = items.map((b, i) => blogCard(b).replace('<div class="wrapper-content">', `<div class="wrapper-content" data-i="${i}">`)).join('');
---
<div class="comp-section-page-content position-relative py-40" id={id} style={styles['bloglist.section']}>
  <div class="b-overlay-wrap position-relative blog-overlay"><div data-listing>
    <div class="container position-relative"></div>
    <div class="container pt-25" id="page-blog-05" style={styles['bloglist.container']}>
      <div class="wrapper-box-blog" data-grid set:html={cells} />
      <div class="d-flex justify-content-center mt-20"><div class="system-pagination"><div class="list-pagination"><ul aria-label="Pagination" class="pagination b-pagination" role="menubar" data-pager></ul></div></div></div>
    </div>
  </div></div>
</div>
