---
import Base from '../../layouts/Base.astro';
import { head, enc } from '../../lib/site.js';
import ProductListing from '../../components/ProductListing.astro';
import { brandPages } from '../../lib/listing.js';
export function getStaticPaths() {
  return brandPages().map(({ path, page }) => ({ params: { path: path.replace(/^productbrand\//, '') }, props: { page } }));
}
const { page } = Astro.props;
---
<Base title={page.seo.title} description={page.seo.description} keywords={page.keywords} canonical={head.siteUrl + enc(page.canonical)}><ProductListing {...page} /></Base>
