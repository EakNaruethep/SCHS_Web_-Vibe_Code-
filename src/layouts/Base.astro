---
// Shared page frame: <head>, the Makewebeasy header/footer markup, cookie banner and small scripts.
import '../styles/global.css';
import { head, menu, partials } from '../lib/site.js';
import seo from '../data/site/seo.json';
import { desktopMenu, mobileMenu } from '../lib/menu.js';

const path = decodeURI(Astro.url.pathname).replace(/\.html$/, '').replace(/\/index$/, '') || '/';
// Titles/descriptions captured from the live site are the fallback when a page doesn't pass its own.
const { title = seo[path]?.title || head.siteName, description = seo[path]?.description || '', keywords = seo[path]?.keywords ?? head.keywords ?? '', ogType = 'website', ogImage = '', canonical, jsonld = [], noindex = false } = Astro.props;
const canonicalUrl = canonical || head.siteUrl + (path === '/' ? '' : encodeURI(path));
const og = ogImage ? (ogImage.startsWith('http') ? ogImage : head.siteUrl + encodeURI(ogImage)) : head.siteUrl + '/images/01_Home/OG.jpg';
const top = partials['../partials/shell-top.html']
  .replace('@@MENU@@', desktopMenu(menu, path))
  .replace('@@SIDENAV@@', mobileMenu(menu, path));
const bottom = partials['../partials/shell-bottom.html'];
const ld = jsonld.map((j) => (typeof j === 'string' ? j : JSON.stringify(j)));
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <!-- Makewebeasy sent phones (by user agent) a separate phone layout, and in a desktop browser its components switch
         to their phone sizes at 576px wide and below ("mobile") and partly at 768px and below ("tablet").
         html.schs-phone = phone; html.schs-mobile = phone or narrow window; html.schs-tablet = 577-768px window. -->
    <script is:inline>(function () {
      var h = document.documentElement, phone = /Mobi|Android|iPhone|iPod/i.test(navigator.userAgent);
      var set = function () {
        var w = window.innerWidth;
        h.classList.toggle('schs-phone', phone);
        h.classList.toggle('schs-mobile', phone || w <= 576);
        h.classList.toggle('schs-tablet', !phone && w > 576 && w <= 768);
      };
      set(); window.addEventListener('resize', set);
    })();</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {keywords && <meta name="Keywords" content={keywords} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={og} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="schomesquare.co.th" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={og} />
    <meta name="twitter:domain" content={head.siteUrl} />
    <meta name="twitter:site" content="schomesquare.co.th" />
    <meta name="google-site-verification" content={head.googleSiteVerification} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" href={canonicalUrl} hreflang="th-th" />
    <link rel="alternate" href={canonicalUrl} hreflang="x-default" />
    <link rel="icon" type="image/x-icon" href={head.favicon} />
    <link rel="apple-touch-icon" sizes="180x180" href={head.favicon} />
    <link rel="shortcut icon" type="image/x-icon" href={head.favicon} />
    <link rel="preload" as="font" type="font/woff2" crossorigin="anonymous" href="/fonts/sarabun/DtVjJx26TKEr37c9aAFJn3YO5gjupg.woff2" />
    <link rel="preload" as="font" type="font/woff" crossorigin="anonymous" href="/images/attach_file/font/Kanit_Regular.woff" />
    <link rel="preload" as="font" type="font/woff" crossorigin="anonymous" href="/images/attach_file/font/Kanit_SemiBold.woff" />
    {ld.map((j) => <script type="application/ld+json" set:html={j} />)}
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${head.gaId}`}></script>
    <script is:inline define:vars={{ gaId: head.gaId }}>
      window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', gaId);
    </script>
    <script is:inline define:vars={{ chatconeId: head.chatconeId }}>window.chatconewidget = { init: chatconeId };</script>
    <script is:inline async src="https://widget.chatcone.com/js/widget.bundle.js"></script>
  </head>
  <body>
    <Fragment set:html={top} />
    <slot />
    <Fragment set:html={bottom} />
    <script src="../scripts/site.js"></script>
  </body>
</html>
